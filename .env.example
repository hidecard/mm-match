# Environment Variables Template
# Copy this to .env file and fill in your actual values

BOT_TOKEN=your_bot_token_here
TURSO_URL=your_turso_url_here
TURSO_TOKEN=your_turso_token_here

# Admin Configuration
ADMIN_IDS=123456789,987654321  # Comma-separated list of Telegram user IDs for admins
DASHBOARD_PASSWORD=your_dashboard_password_here  # Password for admin dashboard

# Cloudflare Workers AI Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
